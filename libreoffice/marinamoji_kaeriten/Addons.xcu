          <prop oor:name="ImageBigURL" oor:type="xs:string">
            <value>%origin%/icons/apply_warichu.svg</value>
          </prop>
        </node>
      </node>
      <node oor:name="org.marinaMoji.kaeriten.remove_warichu" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>org.marinaMoji.kaeriten:remove_warichu</value>
